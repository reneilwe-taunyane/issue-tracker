generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Severity {
  low
  medium
  high
  critical
}

enum Status {
  open
  in_progress
  resolved
  closed
}

/// Application roles for RBAC.
/// - user: default; report bugs, comment, vote
/// - admin: site catalog access. Does not grant power inside an organization.
/// - super_admin: site-wide access, including every organization's admin powers
enum Role {
  user
  admin
  super_admin
}

enum ActivityType {
  created
  status_changed
  severity_changed
  assignee_changed
  commented
  edited
  milestone_changed
  boosted
  unboosted
  deleted
  restored
  comment_deleted
  type_changed
  category_changed
  duplicate_changed
}

/// A person's role inside a tenant (#423). Everyone who existed when the
/// agent platform landed is a member of Zedu; a tenant's creator is its owner.
enum MembershipRole {
  owner
  admin
  member
}

/// What an agent may do (#427). Each level includes the ones before it.
enum AgentLevel {
  observer
  contributor
  reviewer
  merger
}

enum MissionRole {
  admin
  member
  signed_out
}

enum MissionViewport {
  desktop
  mobile_375
}

/// An offered claim becomes active when accepted (#449); either may be
/// released, by the agent, by expiry, or by silence (#438).
enum ClaimStatus {
  offered
  active
  released
}

enum ValidationKind {
  real
  format
  duplicate
  fix
}

enum ValidationVerdict {
  accept
  reject
}

enum RedesignStatus {
  proposed
  approved
  rejected
  superseded
}

/// A submission row is pending until enough independent reviewers accept it;
/// any reject vetoes it (#617).
enum JobSubmissionStatus {
  pending
  accepted
  rejected
}

enum PointRole {
  solver
  reporter
  reviewer
  /// Paid to the submitter's owner when a research job row is accepted (#617).
  submission
}

enum DisputeStatus {
  open
  granted
  rejected
}

enum WebhookDeliveryStatus {
  pending
  delivered
  failed
  /// Out of retries (#445). The poll feed still has the event.
  dead
}

/// Light or dark appearance (#277). "system" follows the device.
enum ThemePreference {
  system
  light
  dark
}

enum TenantJoinRequestStatus {
  pending
  approved
  rejected
}

enum CommentType {
  comment
  bid
  review
  delivery
  request_to_merge
}

model User {
  id                    String               @id @default(cuid())
  name                  String
  email                 String               @unique
  /// Null for Google-only accounts; required for credentials login/signup.
  passwordHash          String?
  emailVerified         DateTime?
  image                 String?
  role                  Role                 @default(user)
  /// #277: stored per user so the choice follows them to every device.
  theme                 ThemePreference      @default(system)
  /// Email when mentioned, assigned, or when an issue you reported changes status (#151).
  /// Master switch. The notify* flags below pick which kinds when it is on.
  emailNotifications    Boolean              @default(true)
  notifyMentions        Boolean              @default(true)
  notifyAssignments     Boolean              @default(true)
  notifyStatusChanges   Boolean              @default(true)
  /// #287: site-wide keyboard shortcuts; per user so it follows them.
  keyboardShortcuts     Boolean              @default(true)
  /// #618: optional EVM address (0x + 40 hex) points could later be sent to.
  /// Set only by the person themselves; read only by them and tenant admins.
  walletAddress         String?
  /// Bumped on password reset; JWTs carrying an older value are rejected (#208).
  sessionVersion        Int                  @default(0)
  createdAt             DateTime             @default(now())
  reportedBugs          Bug[]                @relation("BugReporter")
  assignedBugs          Bug[]                @relation("BugAssignee")
  attachments           Attachment[]
  comments              Comment[]
  votes                 Vote[]
  activities            BugActivity[]
  bugRevisions          BugRevision[]
  passwordResetTokens   PasswordResetToken[]
  watches               IssueWatch[]
  notifications         Notification[]
  // Agent platform (#423).
  memberships           Membership[]
  agents                Agent[]
  agentPairingsApproved AgentPairing[]
  beneficiaryBugs       Bug[]                @relation("BugBeneficiary")
  claims                IssueClaim[]
  issueBids             IssueBid[]           @relation("IssueBidBeneficiary")
  interests             IssueInterest[]      @relation("IssueInterestBeneficiary")
  validations           IssueValidation[]
  testVerdicts          TestVerdict[]
  reviewOffers          ReviewOffer[]
  redesignsOnBehalf     RedesignProposal[]   @relation("RedesignOnBehalfOf")
  redesignsApproved     RedesignProposal[]   @relation("RedesignApprover")
  pointEntries          PointEntry[]
  pointDisputes         PointDispute[]       @relation("DisputeOpener")
  pointDisputesResolved PointDispute[]       @relation("DisputeResolver")
  auditActions          AgentAuditEvent[]    @relation("AuditActorUser")
  agentQuestions        AgentQuestion[]
  tenantInvitesSent     TenantInvite[]
  membershipChangesMade MembershipChange[] @relation("MembershipChangeActor")
  membershipChangesReceived MembershipChange[] @relation("MembershipChangeTarget")
  shareLinksSent        TenantShareLink[]
  shareRedemptions      TenantShareRedemption[]
  tenantJoinRequests    TenantJoinRequest[] @relation("TenantJoinRequester")
  joinRequestsReviewed  TenantJoinRequest[] @relation("TenantJoinReviewer")
  projectAuditEvents    ProjectAuditEvent[]
  jobsCreated           Job[]                 @relation("JobCreator")
  jobSubmissions        JobSubmission[]       @relation("JobSubmissionBeneficiary")
  jobReviews            JobReview[]           @relation("JobReviewBeneficiary")
  jobReviewOffers       JobReviewOffer[]      @relation("JobReviewOfferBeneficiary")
  approvalsDecided      IssueApproval[]      @relation("ApprovalDecider")
}

/// Single-use password reset tokens (~30 min TTL). Store only the SHA-256 hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IssueType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Markdown that pre-fills the report form's description (#307). Null: none.
  template    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bugs        Bug[]
  approvalRules ApprovalRule[]
}

model Bug {
  id                String             @id @default(cuid())
  /// Human-readable reference (#1, #2, ...), counted per tenant (#517). The
  /// database trigger `Bug_assign_tenant_number` replaces the sequence value
  /// with `Tenant.nextIssueNumber`, so each organisation starts at #1.
  number            Int                @default(autoincrement())
  title             String
  description       String
  severity          Severity           @default(medium)
  status            Status             @default(open)
  typeId            String?
  type              IssueType?         @relation(fields: [typeId], references: [id], onDelete: SetNull)
  voteCount         Int                @default(0)
  isBoosted         Boolean            @default(false)
  boostedAt         DateTime?
  /// #289: at most one milestone. Cleared, not cascaded, when it's deleted.
  milestoneId       String?
  milestone         Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  isDeleted         Boolean            @default(false)
  deletedAt         DateTime?
  proofLinks        String[]           @default([])
  reporterId        String
  assigneeId        String?
  categoryId        String?
  /// #285: set when this issue is a duplicate of another. One level only:
  /// the target is never itself a duplicate (enforced in the action).
  duplicateOfId     String?
  duplicateOf       Bug?               @relation("BugDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates        Bug[]              @relation("BugDuplicates")
  /// #423: every issue belongs to a tenant and one of its projects.
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// #423: the person the work is for. The reporter unless an agent filed it
  /// for someone else; points go to this person, never to the agent.
  beneficiaryUserId String
  beneficiary       User               @relation("BugBeneficiary", fields: [beneficiaryUserId], references: [id])
  /// #423: set when an agent filed the issue. Null for people.
  createdByAgentId  String?
  createdByAgent    Agent?             @relation("AgentCreatedBugs", fields: [createdByAgentId], references: [id], onDelete: SetNull)
  /// #452: the pull request that fixes this issue, if one is linked.
  pullRequestUrl    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  reporter          User               @relation("BugReporter", fields: [reporterId], references: [id])
  assignee          User?              @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  attachments       Attachment[]
  category          Category?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comments          Comment[]
  votes             Vote[]
  watches           IssueWatch[]
  notifications     Notification[]
  activities        BugActivity[]
  revisions         BugRevision[]
  claims            IssueClaim[]
  approvals         IssueApproval[]
  bids              IssueBid[]
  interests         IssueInterest[]
  validations       IssueValidation[]
  testVerdicts      TestVerdict[]
  reviewOffers      ReviewOffer[]
  redesigns         RedesignProposal[]
  pointEntries      PointEntry[]
  pointDisputes     PointDispute[]
  agentQuestions    AgentQuestion[]
  idempotencyKeys   IdempotencyKey[]
  agentEvents       AgentEvent[]
  auditEvents       AgentAuditEvent[]

  /// #517: issue numbers are per tenant, so two tenants can both have a #1.
  @@unique([tenantId, number])
  @@index([tenantId, projectId])
  @@index([beneficiaryUserId])
  @@index([createdByAgentId])
  @@index([categoryId])
  @@index([typeId])
  @@index([duplicateOfId])
  @@index([isBoosted])
  @@index([isDeleted])
  @@index([milestoneId])
  // #217: foreign keys behind the "Assigned to me" / "Reported by me" filters.
  @@index([assigneeId])
  @@index([reporterId])
  // #217: match getBugOrderBy() exactly (boosted first, then the chosen sort),
  // so the list can be read in index order instead of sorting every row.
  @@index([isDeleted, isBoosted(sort: Desc), boostedAt(sort: Desc), voteCount(sort: Desc), updatedAt(sort: Desc), createdAt(sort: Desc)], map: "Bug_list_top_votes_idx")
  @@index([isDeleted, isBoosted(sort: Desc), boostedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "Bug_list_newest_idx")
}

/// A platform (Desktop, Web, Mobile) inside one organization.
/// The same name can exist in another organization; it is a different platform.
model Category {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bugs      Bug[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

/// A release or sprint grouping issues (#289).
model Milestone {
  id          String    @id @default(cuid())
  title       String    @unique
  description String?
  /// A calendar day; no time of day.
  dueDate     DateTime? @db.Date
  /// Closing a milestone leaves its issues alone.
  isClosed    Boolean   @default(false)
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bugs        Bug[]

  @@index([isClosed, dueDate])
}

model BugActivity {
  id        String       @id @default(cuid())
  bugId     String
  actorId   String
  type      ActivityType
  summary   String
  metadata  Json?
  createdAt DateTime     @default(now())
  bug       Bug          @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actor     User         @relation(fields: [actorId], references: [id])

  @@index([bugId, createdAt])
}

/// A title + description an edit replaced (#303). The issue row holds the
/// current version; these are the ones before it.
model BugRevision {
  id          String   @id @default(cuid())
  bugId       String
  title       String
  description String
  /// Who made the edit that replaced this version. Null if since deleted.
  editedById  String?
  editedAt    DateTime @default(now())
  bug         Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  editedBy    User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)

  @@index([bugId, editedAt])
}

model Comment {
  id          String       @id @default(cuid())
  bugId       String
  authorId    String
  parentId    String?
  body        String
  type        CommentType  @default(comment)
  metadata    Json?
  createdAt   DateTime     @default(now())
  /// Set when the author edits the comment; shown as "edited".
  editedAt    DateTime?
  /// Soft delete: the body is cleared and replies keep their place.
  deletedAt   DateTime?
  /// #423: the agent that wrote it for `authorId`. Null for people.
  agentId     String?
  agent       Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  bug         Bug          @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  parent      Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]    @relation("CommentReplies")
  attachments Attachment[]

  @@index([bugId])
  @@index([bugId, type])
  @@index([bugId, createdAt])
  @@index([parentId])
}

/// Files attached to an issue or a comment (#215): screenshots, logs, PDFs,
/// HAR files. Stored in Postgres (max 5 MB, checked in lib/attachments.ts)
/// and only served to signed-in users. Uploaded first, then linked to the
/// issue or comment when it's saved; until then only the uploader can see it.
model Attachment {
  id          String   @id @default(cuid())
  uploaderId  String
  bugId       String?
  commentId   String?
  redesignProposalId String?
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  bug         Bug?     @relation(fields: [bugId], references: [id], onDelete: Cascade)
  comment     Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  redesignProposal RedesignProposal? @relation(fields: [redesignProposalId], references: [id], onDelete: Cascade)

  @@index([bugId])
  @@index([commentId])
  @@index([redesignProposalId])
  @@index([uploaderId, createdAt])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  bugId     String
  value     Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@unique([userId, bugId])
  @@index([bugId])
}

/// Who follows an issue (#216). People are watching by default when they
/// report, are assigned to or comment on an issue; `watching = false` records
/// an explicit "Unwatch" so they aren't added back automatically.
model IssueWatch {
  userId    String
  bugId     String
  watching  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@id([userId, bugId])
  @@index([bugId])
}

/// In-app notification feed (#216): one row per person per event, written
/// whether or not email is configured or wanted.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  tenantId  String?
  bugId     String?
  /// Event kind, e.g. "comment_added", "mentioned", "status_changed".
  kind      String
  title     String
  /// App-relative link, e.g. /bugs/<id>#comment-<id>.
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  bug       Bug?      @relation(fields: [bugId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([userId, tenantId, readAt])
}

/// Sliding-window rate-limit attempts, shared by every app instance (#296).
/// `key` is a SHA-256 of the limiter key (it contains emails and IPs); `at`
/// is epoch milliseconds. Rows older than the longest window are deleted.
model RateLimitHit {
  id  BigInt @id @default(autoincrement())
  key String
  at  BigInt

  @@index([key, at])
}

// ---------------------------------------------------------------------------
// Agent platform (#422, #423). People and their agents work the same issues
// inside a tenant. This block is owned by #423: later platform issues add
// files, not columns.
// ---------------------------------------------------------------------------

/// An organisation on Ziki. Zedu is the first.
model Tenant {
  id            String             @id @default(cuid())
  slug          String             @unique
  name          String
  description   String?            @db.VarChar(500)
  discoverable  Boolean            @default(false)
  /// Set when an owner archives the tenant (#573). Archived tenants are
  /// hidden from the switcher and cannot be selected.
  archivedAt    DateTime?
  /// #517: the next issue number this tenant hands out. The insert trigger
  /// increments it under a row lock, so concurrent creates stay unique.
  nextIssueNumber Int             @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  projects      Project[]
  categories    Category[]
  memberships   Membership[]
  agents        Agent[]
  bugs          Bug[]
  auditEvents   AgentAuditEvent[]
  redesigns     RedesignProposal[]
  pointEntries  PointEntry[]
  pointDisputes PointDispute[]
  invites       TenantInvite[]
  shareLinks    TenantShareLink[]
  events        AgentEvent[]
  membershipChanges MembershipChange[]
  joinRequests  TenantJoinRequest[]
  notifications Notification[]
  projectAuditEvents ProjectAuditEvent[]
  jobs          Job[]
}

/// A product inside a tenant, e.g. Zedu Web or Zedu Desktop. Not the same as
/// Category, the per-organization platform filter.
model Project {
  id                   String             @id @default(cuid())
  tenantId             String
  slug                 String
  name                 String
  /// What the project is for, shown to agents (#437).
  goal                 String?
  repoUrl              String?
  stagingUrl           String?
  /// GitHub App installation used to merge accepted fixes (#452). Never a token.
  githubInstallationId String?
  /// Set when a tenant owner archives the project (#573). Archived projects
  /// are hidden from the switcher and cannot be selected.
  archivedAt           DateTime?
  /// How long an accepted claim has to link a fix before it is released (#593).
  /// High and critical issues use at least 60 minutes (lib/claim-deadline.ts).
  deliveryWindowMinutes Int              @default(15)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bugs                 Bug[]
  redesigns            RedesignProposal[]
  apiKeys              AgentApiKey[]
  pairings             AgentPairing[]
  defaultAgents        Agent[]            @relation("DefaultProjectAgent")
  testMissions         TestMission[]
  auditEvents          ProjectAuditEvent[]
  jobs                 Job[]
  agentEvents          AgentEvent[]
  approvalRules        ApprovalRule[]

  @@unique([tenantId, slug])
}

/// A route, role, and viewport slice for exploratory testing (#619).
model TestMission {
  id                  String          @id @default(cuid())
  projectId           String
  routePattern        String
  brief               String
  role                MissionRole
  viewport            MissionViewport
  lastCoveredAt       DateTime?
  issuesFiled         Int             @default(0)
  lastAssignedAt      DateTime?
  lastAssignedOwnerId String?
  leaseAgentId        String?
  leaseOwnerId        String?
  leaseExpiresAt      DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  project             Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, routePattern, role, viewport])
  @@index([projectId, lastCoveredAt, lastAssignedAt])
  @@index([leaseAgentId, leaseExpiresAt])
}

/// Human changes to project configuration, including GitHub App linking.
model ProjectAuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  projectId   String
  actorUserId String
  action      String
  changes     Json
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([projectId, createdAt])
  @@index([actorUserId, createdAt])
}

model Membership {
  id        String         @id @default(cuid())
  tenantId  String
  userId    String
  role      MembershipRole @default(member)
  createdAt DateTime       @default(now())
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
}

/// A change to who is in a tenant and what they can do there.
/// Site-wide User.role is not this: an admin of one organization is a member of another.
model MembershipChange {
  id           String          @id @default(cuid())
  tenantId     String
  actorUserId  String?
  targetUserId String?
  /// "role_changed", "removed", or "left".
  action       String
  fromRole     MembershipRole?
  toRole       MembershipRole?
  createdAt    DateTime        @default(now())
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor        User?           @relation("MembershipChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User?           @relation("MembershipChangeTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

/// A request to join a workspace listed in discovery. Approval is the only
/// path from this record to membership; the unique pair prevents duplicates.
model TenantJoinRequest {
  id           String                   @id @default(cuid())
  tenantId     String
  userId       String
  status       TenantJoinRequestStatus  @default(pending)
  requestedAt  DateTime                 @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                     @relation("TenantJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?                    @relation("TenantJoinReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, status, requestedAt])
  @@index([userId, requestedAt])
}

/// A named agent working for its owner inside a tenant (#427). It always acts
/// as itself and for a named person.
model Agent {
  id                   String                @id @default(cuid())
  tenantId             String
  ownerUserId          String
  /// Display name, e.g. "Larry's Claude".
  name                 String
  /// The model behind it, e.g. "Claude" or "GPT". Not the display name.
  model                String?
  level                AgentLevel            @default(observer)
  /// Higher rate budget, set only by a tenant admin (#440).
  burst                Boolean               @default(false)
  revokedAt            DateTime?
  /// Set when this is the person's personal agent for that project.
  /// Created automatically so they can copy a key without registering one.
  defaultProjectId     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner                User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  defaultProject       Project?              @relation("DefaultProjectAgent", fields: [defaultProjectId], references: [id], onDelete: Cascade)
  apiKeys              AgentApiKey[]
  auditEvents          AgentAuditEvent[]
  createdBugs          Bug[]                 @relation("AgentCreatedBugs")
  comments             Comment[]
  claims               IssueClaim[]
  bids                 IssueBid[]
  interests            IssueInterest[]
  validations          IssueValidation[]
  testVerdicts         TestVerdict[]
  reviewOffers         ReviewOffer[]
  redesigns            RedesignProposal[]
  questions            AgentQuestion[]
  idempotencyKeys      IdempotencyKey[]
  events               AgentEvent[]
  webhookSubscriptions WebhookSubscription[]
  jobSubmissions       JobSubmission[]
  jobReviews           JobReview[]
  jobReviewOffers      JobReviewOffer[]
  inboxItems           AgentInboxItem[]

  @@unique([ownerUserId, defaultProjectId])
  @@index([tenantId])
  @@index([ownerUserId])
}

/// A one-way hash of the key is always stored. The raw key is shown once,
/// except a person's personal project key, which is also sealed so they can copy it.
model AgentApiKey {
  id         String    @id @default(cuid())
  agentId    String
  /// The only project this key may act in. Null is a legacy key that still
  /// works across the tenant; new keys always set it (#742).
  projectId  String?
  /// SHA-256 of the raw key.
  keyHash    String    @unique
  /// AES-256-GCM of the raw key. Set only for a personal project key, so the
  /// owner can copy it again. Other keys stay hash-only.
  sealedKey  String?
  /// The first characters of the key, so the owner can tell keys apart.
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  agent      Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentId, projectId])
}

/// Pairing an agent by code (#427). The owner is set only when a signed-in
/// member approves the code.
model AgentPairing {
  id             String    @id @default(cuid())
  /// SHA-256 of the pairing code.
  codeHash       String    @unique
  proposedName   String
  expiresAt      DateTime
  ownerUserId    String?
  /// The tenant the agent joins, set on approval.
  tenantId       String?
  /// The project the issued key is limited to, set on approval (#742).
  projectId      String?
  /// The agent row created on approval.
  agentId        String?
  /// SHA-256 of the secret the waiting agent polls with to collect its key.
  deviceCodeHash String    @unique
  proposedModel  String?
  /// Set when the waiting agent has collected its key; single use.
  consumedAt     DateTime?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  owner          User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
}

/// Every agent action, so any call can be traced and undone (#427, #450).
model AgentAuditEvent {
  id          String    @id @default(cuid())
  tenantId    String
  agentId     String
  action      String
  /// What the action was on, e.g. "bug:<id>".
  target      String?
  /// The issue, when there is one, so the log can be filtered by it (#447).
  bugId       String?
  /// A person acting on the agent, e.g. a tenant admin's undo (#450) or a
  /// level change (#451). Null when the agent acted.
  actorUserId String?
  payload     Json?
  /// Set by a tenant admin's undo; the row itself is kept.
  undoneAt    DateTime?
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bug         Bug?      @relation(fields: [bugId], references: [id], onDelete: SetNull)
  actorUser   User?     @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([agentId, createdAt])
  @@index([bugId, createdAt])
  @@index([createdAt])
}

/// An agent working an issue for a person (#432, #438, #449).
model IssueClaim {
  id                String      @id @default(cuid())
  bugId             String
  beneficiaryUserId String
  agentId           String
  status            ClaimStatus @default(active)
  offeredAt         DateTime?
  claimedAt         DateTime?
  lastHeartbeatAt   DateTime?
  /// When the fix is due (#593). Set when an offer or bid becomes active.
  deliverBy         DateTime?
  /// Set when the agent spends its one extension; a second request is refused.
  extendedAt        DateTime?
  /// Why the agent asked for more time, shown in the audit log.
  extensionReason   String?
  releasedAt        DateTime?
  /// Why it was released: "silence" (#438), "deadline" (#593), "expired"
  /// (#449), "undo" (#450), "agent", "resolved", or "closed". #451 counts
  /// silence and deadline releases.
  releaseReason     String?
  createdAt         DateTime    @default(now())
  bug               Bug         @relation(fields: [bugId], references: [id], onDelete: Cascade)
  beneficiary       User        @relation(fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  agent             Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)

  awardedBid        IssueBid?
  @@index([bugId, releasedAt])
  @@index([beneficiaryUserId, releasedAt])
  @@index([agentId])
  @@index([deliverBy])
  // Enforced by a partial unique index in the migration: one pending offer per issue.
  // Enforced by a partial unique index in the migration: one active claim per issue (#662).
}

/// An agent asking for an open task. A bid does not assign the issue.
/// A person awards one bid, and that award becomes the active claim.
model IssueBid {
  id                String      @id @default(cuid())
  bugId             String
  agentId           String
  beneficiaryUserId String
  /// Why this agent wants the task. Optional, and short.
  note              String?
  createdAt         DateTime    @default(now())
  withdrawnAt       DateTime?
  awardedAt         DateTime?
  claimId           String?     @unique
  bug               Bug         @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent             Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User        @relation("IssueBidBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  claim             IssueClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@unique([bugId, agentId])
  @@index([bugId, createdAt])
}

/// A reviewer agent's verdict on an issue or its fix (#433). One per agent
/// per issue per kind.
/// An agent volunteering to work on a confirmed issue (#589).
model IssueInterest {
  id                String    @id @default(cuid())
  bugId             String
  agentId           String
  beneficiaryUserId String
  /// Optional note explaining interest (up to 500 chars).
  note              String?
  createdAt         DateTime  @default(now())
  withdrawnAt       DateTime?
  bug               Bug       @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent             Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User      @relation("IssueInterestBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)

  @@unique([bugId, agentId])
  @@index([bugId, withdrawnAt])
  @@index([beneficiaryUserId])
}

model IssueValidation {
  id               String            @id @default(cuid())
  bugId            String
  agentId          String
  onBehalfOfUserId String
  kind             ValidationKind
  verdict          ValidationVerdict
  notes            String?
  /// For a duplicate verdict, the canonical issue.
  duplicateOfId    String?
  /// The severity this reviewer set when accepting kind `real` (#433).
  severity         Severity?
  /// What it was before, so an undo can restore it (#450).
  previousSeverity Severity?
  createdAt        DateTime          @default(now())
  bug              Bug               @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent            Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  onBehalfOf       User              @relation(fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)

  @@unique([bugId, agentId, kind])
  @@index([bugId, kind])
}

/// Whether a fix is good to merge (#434).
model TestVerdict {
  id               String   @id @default(cuid())
  bugId            String
  agentId          String
  onBehalfOfUserId String
  goodToMerge      Boolean
  notes            String?
  /// The pull request this verdict tested (#526). Only verdicts on the
  /// issue's current pull request count towards the merge gate.
  pullRequestUrl   String?
  createdAt        DateTime @default(now())
  /// Set when the reviewer changed their verdict (#529).
  changedAt        DateTime?
  bug              Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  onBehalfOf       User     @relation(fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)

  @@unique([bugId, agentId])
  @@index([bugId])
  @@index([agentId])
}

/// A redesign an agent proposes; blocked until a person approves it (#431).
/// An offer to an independent reviewer agent to test and validate a fix (#597).
model ReviewOffer {
  id                String    @id @default(cuid())
  bugId             String
  agentId           String
  beneficiaryUserId String
  status            String    @default("offered")
  offeredAt         DateTime  @default(now())
  acceptedAt        DateTime?
  completedAt       DateTime?
  expiredAt         DateTime?
  deadlineAt        DateTime?
  pullRequestUrl    String
  headSha           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  bug               Bug       @relation(fields: [bugId], references: [id], onDelete: Cascade)
  agent             Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User      @relation(fields: [beneficiaryUserId], references: [id], onDelete: Cascade)

  @@index([bugId, status])
  @@index([agentId, status])
  @@index([beneficiaryUserId, status])
}

/// Non-code work, e.g. research, where many agents submit rows and N
/// independent reviewers accept them (#617). The bug flow is untouched.
model Job {
  id               String    @id @default(cuid())
  tenantId         String
  projectId        String
  /// The person who posted the job.
  createdById      String
  brief            String
  /// JSON-Schema-like description of each submission row, or null for free-form.
  submissionSchema Json?
  /// The submission-row field dedupe is keyed on, e.g. "url".
  dedupeKey        String
  maxSubmissions   Int
  pointsPerAccepted Int
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User      @relation("JobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  submissions      JobSubmission[]

  @@index([tenantId, createdAt])
  @@index([projectId])
}

/// One row an agent posted for a job. Dedupe is per job on the resolved
/// `dedupeKey` value (#617).
model JobSubmission {
  id                String             @id @default(cuid())
  jobId             String
  agentId           String
  /// The person the points go to — the submitting agent's owner.
  beneficiaryUserId String
  data              Json
  /// The resolved value of `job.dedupeKey` in `data`.
  dedupeKey         String
  status            JobSubmissionStatus @default(pending)
  /// Independent accepts needed before the row is accepted (default 2, capped
  /// by how many distinct reviewers actually exist).
  reviewsNeeded     Int                @default(2)
  reviewedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  job               Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  agent             Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User               @relation("JobSubmissionBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)
  reviews           JobReview[]
  offers            JobReviewOffer[]

  @@unique([jobId, dedupeKey])
  @@index([jobId, status])
  @@index([agentId])
  @@index([status])
}

/// One reviewer's verdict on a submission. Any reject vetoes; accepts from
/// `reviewsNeeded` distinct owners pay the submitter once (#617).
model JobReview {
  id                String           @id @default(cuid())
  submissionId      String
  agentId           String
  beneficiaryUserId String
  verdict           ValidationVerdict
  notes             String?
  createdAt         DateTime         @default(now())
  submission        JobSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  agent             Agent            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User             @relation("JobReviewBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)

  @@unique([submissionId, agentId])
  @@index([agentId])
}

/// Mirrors ReviewOffer for job submissions: accept an offer first, then leave
/// a verdict, with the same TTL and deadline semantics (#597, #617).
model JobReviewOffer {
  id                String         @id @default(cuid())
  submissionId      String
  agentId           String
  beneficiaryUserId String
  /// "offered", "accepted", "completed", or "expired".
  status            String         @default("offered")
  offeredAt         DateTime       @default(now())
  acceptedAt        DateTime?
  completedAt       DateTime?
  expiredAt         DateTime?
  deadlineAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt
  submission        JobSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  agent             Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  beneficiary       User           @relation("JobReviewOfferBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)

  @@index([submissionId, status])
  @@index([agentId, status])
  @@index([beneficiaryUserId, status])
}

model RedesignProposal {
  id               String         @id @default(cuid())
  tenantId         String
  projectId        String
  bugId            String?
  authorAgentId    String
  onBehalfOfUserId String
  title            String
  body             String
  previewUrl       String?
  status           RedesignStatus @default(proposed)
  approverId       String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bug              Bug?           @relation(fields: [bugId], references: [id], onDelete: SetNull)
  authorAgent      Agent          @relation(fields: [authorAgentId], references: [id], onDelete: Cascade)
  onBehalfOf       User           @relation("RedesignOnBehalfOf", fields: [onBehalfOfUserId], references: [id], onDelete: Cascade)
  approver         User?          @relation("RedesignApprover", fields: [approverId], references: [id], onDelete: SetNull)
  attachments      Attachment[]

  @@index([tenantId, status])
  @@index([bugId])
}

/// The points ledger (#428). Rows are never deleted; a correction is a new
/// row. `sourceKey` makes every award idempotent.
model PointEntry {
  id          String         @id @default(cuid())
  tenantId    String
  userId      String
  bugId       String?
  role        PointRole
  /// Negative for a correction.
  points      Int
  sourceKey   String         @unique
  /// Set when a later entry corrects this one (#436, #450). Never deleted.
  correctedAt DateTime?
  createdAt   DateTime       @default(now())
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug         Bug?           @relation(fields: [bugId], references: [id], onDelete: SetNull)
  disputes    PointDispute[]

  @@index([tenantId, userId])
  @@index([bugId])
}

/// A member saying an award is missing or wrong (#436).
model PointDispute {
  id           String        @id @default(cuid())
  tenantId     String
  userId       String
  pointEntryId String?
  bugId        String
  /// The award a "missing" dispute asked for. Empty when the dispute is about an existing entry.
  requestedRole PointRole?
  reason       String
  status       DisputeStatus @default(open)
  resolvedById String?
  /// What the admin decided and why.
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User          @relation("DisputeOpener", fields: [userId], references: [id], onDelete: Cascade)
  pointEntry   PointEntry?   @relation(fields: [pointEntryId], references: [id], onDelete: SetNull)
  resolvedBy   User?         @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  bug          Bug           @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([userId])
}

/// An agent asking its owner something (#446). The answer is set once.
model AgentQuestion {
  id          String    @id @default(cuid())
  agentId     String
  ownerUserId String
  bugId       String?
  body        String
  answer      String?
  answeredAt  DateTime?
  createdAt   DateTime  @default(now())
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  owner       User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  bug         Bug?      @relation(fields: [bugId], references: [id], onDelete: SetNull)

  @@index([ownerUserId, answeredAt])
  @@index([agentId])
}

/// A single-use invite to a tenant (#444). Only the token's hash is stored.
model TenantInvite {
  id          String         @id @default(cuid())
  tenantId    String
  email       String
  role        MembershipRole @default(member)
  tokenHash   String         @unique
  expiresAt   DateTime
  invitedById String
  acceptedAt  DateTime?
  createdAt   DateTime       @default(now())
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy   User           @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

/// A shareable invite link for a tenant. Not tied to one email address.
/// The raw token is encrypted so an owner can copy it again; acceptance
/// looks up the hash. maxUses null means anyone can join until it expires
/// or is revoked. A redemption is one person, so the same account cannot
/// use a seat twice.
model TenantShareLink {
  id             String                  @id @default(cuid())
  tenantId       String
  tokenHash      String                  @unique
  tokenEncrypted String
  /// Optional note so an owner can tell links apart. Never shown to guests.
  label          String?
  expiresAt      DateTime
  maxUses        Int?
  useCount       Int                     @default(0)
  revokedAt      DateTime?
  invitedById    String
  createdAt      DateTime                @default(now())
  tenant         Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy      User                    @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  redemptions    TenantShareRedemption[]

  @@index([tenantId, createdAt])
}

model TenantShareRedemption {
  id        String          @id @default(cuid())
  linkId    String
  userId    String
  createdAt DateTime        @default(now())
  link      TenantShareLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([linkId, userId])
  @@index([userId])
}

/// One create per agent per Idempotency-Key (#441).
model IdempotencyKey {
  id          String   @id @default(cuid())
  agentId     String
  key         String
  bugId       String?
  requestHash String?
  createdAt   DateTime @default(now())
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bug         Bug?     @relation(fields: [bugId], references: [id], onDelete: SetNull)

  @@unique([agentId, key])
  @@index([createdAt])
}

/// The event log agents poll and webhooks deliver (#445). Cursor is
/// (txid, id): see lib/agent-api/events.ts (#739).
model AgentEvent {
  id           String            @id @default(cuid())
  tenantId     String
  type         String
  payload      Json
  actorAgentId String?
  bugId        String?
  /// The issue's project, filled from `bugId` by a trigger so `?projectId=` can filter (#602).
  projectId    String?
  createdAt    DateTime          @default(now())
  /// The writing transaction's id (#739). Polls only return rows whose
  /// transaction finished, so an event that commits late is never skipped.
  txid         BigInt            @default(dbgenerated("((pg_current_xact_id())::text)::bigint"))
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorAgent   Agent?            @relation(fields: [actorAgentId], references: [id], onDelete: SetNull)
  bug          Bug?              @relation(fields: [bugId], references: [id], onDelete: SetNull)
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]
  inboxItems   AgentInboxItem[]

  @@index([tenantId, createdAt, id])
  @@index([tenantId, txid, id])
  @@index([tenantId, projectId, txid, id])
  @@index([tenantId, bugId, txid, id])
  @@index([createdAt])
}

/// What is addressed to one agent (#601): an offer to it, a reply to its
/// comment, a mention of its owner, an answer, a decision, a claim release.
/// Written next to `publish()`, so polling is one indexed query per agent
/// instead of a scan of the tenant's event feed. The payload is copied from
/// the event so an item outlives event retention.
model AgentInboxItem {
  id        String      @id @default(cuid())
  agentId   String
  /// offer | reply | mention | answer | message | approval | claim
  kind      String
  eventId   String?
  /// The event that put it here, e.g. `claim.offered`.
  eventType String
  bugId     String?
  commentId String?
  payload   Json
  readAt    DateTime?
  createdAt DateTime    @default(now())
  agent     Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  event     AgentEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([agentId, eventId])
  @@index([agentId, createdAt, id])
  @@index([agentId, readAt, createdAt, id])
}

/// An agent with a public HTTPS endpoint opting in to webhooks (#445). The
/// signing secret is encrypted, not hashed: the server must sign with it.
model WebhookSubscription {
  id                     String            @id @default(cuid())
  agentId                String
  url                    String
  signingSecretEncrypted String
  /// Event types to deliver; empty means every event (#512).
  events                 String[]          @default([])
  enabled                Boolean           @default(true)
  /// Consecutive failed deliveries; reset on success (#445).
  failureCount           Int               @default(0)
  /// Set when repeated failures turned the subscription off.
  disabledAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  agent                  Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deliveries             WebhookDelivery[]

  @@index([agentId])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  subscriptionId String
  eventId        String
  attemptCount   Int                   @default(0)
  status         WebhookDeliveryStatus @default(pending)
  nextAttemptAt  DateTime?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  subscription   WebhookSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          AgentEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
}

/// A rule requiring human approval before an issue is offered or merged (#598).
model ApprovalRule {
  id          String         @id @default(cuid())
  projectId   String
  stage       String
  issueTypeId String?
  severity    String?
  fileGlob    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueType   IssueType?     @relation(fields: [issueTypeId], references: [id], onDelete: SetNull)
  approvals   IssueApproval[]

  @@index([projectId, stage])
}

/// A human approval required by an ApprovalRule (#598).
model IssueApproval {
  id              String        @id @default(cuid())
  bugId           String
  ruleId          String?
  stage           String
  status          String        @default("pending")
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bug             Bug           @relation(fields: [bugId], references: [id], onDelete: Cascade)
  rule            ApprovalRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  decidedBy       User?         @relation("ApprovalDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([bugId, stage, status])
}
